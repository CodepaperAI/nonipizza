# External online-ordering URL — every "Order Now" CTA points here.
# Defaults to Noni's Mealsy online-ordering page; override to change it.
NEXT_PUBLIC_ORDER_URL="https://onlineordering.mealsy.ca/en/#/Nonis-Pizza-And-Wings/online/menus"

# Canonical site origin — used for canonical URLs, Open Graph, and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.nonispizza.ca

# Uplift AI Blog Integration Token
UPLIFTAI_BLOG_TOKEN=your_uplift_ai_token_here

# Resend Email Service API Key (for "Send a Query" form)
RESEND_API_KEY=re_123456789_your_key_here
# Note: On Resend's free testing tier (onboarding@resend.dev), set RESEND_TO_EMAIL to your registered Resend email (e.g. knp.nonis@gmail.com). Once your domain is verified at resend.com/domains, set it to any address (e.g. info@nonispizza.ca).
RESEND_TO_EMAIL=knp.nonis@gmail.com
RESEND_FROM_EMAIL="Noni's Pizza <onboarding@resend.dev>"
